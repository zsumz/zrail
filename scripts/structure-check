#!/usr/bin/env python3
"""Bootstrap source-shape checks that run before zrail builds itself."""

from __future__ import annotations

from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parent.parent
EXCLUDED = ROOT / "crates/zrail-testkit/tests/fixtures"
FACADE_NAMES = {"lib.rs", "main.rs", "mod.rs"}
MODULE = re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?mod\s+([A-Za-z_][A-Za-z0-9_]*)\s*;")
PATH_ATTR = re.compile(r'^\s*#\[path\s*=\s*"([^"]+)"\]')
INLINE_TEST = re.compile(
    r"#\[cfg\s*\(\s*test\s*\)\s*\]\s*(?:#\[[^]]+\]\s*)*mod\s+\w+\s*\{",
    re.DOTALL,
)
INLINE_MODULE = re.compile(
    r"^\s*(?:pub(?:\([^)]*\))?\s+)?mod\s+[A-Za-z_][A-Za-z0-9_]*\s*\{",
    re.MULTILINE,
)
IMPLEMENTATION_ITEM = re.compile(
    r"^\s*(?:pub(?:\([^)]*\))?\s+)?"
    r"(?:const|enum|impl|macro_rules!|static|struct|trait|type)\b",
    re.MULTILINE,
)
FUNCTION_ITEM = re.compile(
    r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?fn\s+([A-Za-z_][A-Za-z0-9_]*)",
    re.MULTILINE,
)


def rust_files() -> list[Path]:
    return sorted(
        path
        for path in (ROOT / "crates").rglob("*.rs")
        if EXCLUDED not in path.parents and "target" not in path.parts
    )


def relative(path: Path) -> str:
    return path.relative_to(ROOT).as_posix()


def sibling_owner(test: Path) -> Path | None:
    owner_name = test.stem.removesuffix("_test") + ".rs"
    candidates = [test.with_name(owner_name)]
    candidates.extend(test.with_name(name) for name in ("mod.rs", "lib.rs", "main.rs"))
    return next((candidate for candidate in candidates if candidate.is_file()), None)


def check_test_file(path: Path, errors: list[str]) -> None:
    if not path.name.endswith("_test.rs") or "src" not in path.parts:
        return
    owner = sibling_owner(path)
    if owner is None:
        errors.append(f"{relative(path)}: has no sibling source owner")
        return
    module = path.stem
    declaration = re.compile(
        rf'#\[cfg\(test\)\]\s*#\[path\s*=\s*"{re.escape(path.name)}"\]\s*mod\s+{module}\s*;',
        re.DOTALL,
    )
    if declaration.search(owner.read_text(encoding="utf-8")) is None:
        errors.append(
            f"{relative(path)}: owner {relative(owner)} must declare it with cfg(test) and path"
        )


def module_target(path: Path, module: str, explicit: str | None) -> Path:
    if explicit is not None:
        return path.parent / explicit
    if path.name in FACADE_NAMES:
        direct = path.parent / f"{module}.rs"
        nested = path.parent / module / "mod.rs"
    else:
        direct = path.parent / path.stem / f"{module}.rs"
        nested = path.parent / path.stem / module / "mod.rs"
    return direct if direct.is_file() else nested


def check_module_graph(path: Path, source: str, errors: list[str]) -> None:
    lines = source.splitlines()
    for index, line in enumerate(lines):
        match = MODULE.match(line)
        if match is None:
            continue
        explicit = None
        for previous in reversed(lines[max(0, index - 4) : index]):
            path_match = PATH_ATTR.match(previous)
            if path_match is not None:
                explicit = path_match.group(1)
                break
            if previous.strip() and not previous.lstrip().startswith("#"):
                break
        target = module_target(path, match.group(1), explicit)
        if not target.is_file():
            errors.append(
                f"{relative(path)}:{index + 1}: module {match.group(1)!r} has no source file"
            )


def check_facade(path: Path, source: str, errors: list[str]) -> None:
    if path.name not in FACADE_NAMES:
        return
    inline_module = INLINE_MODULE.search(source)
    if inline_module is not None:
        line = source.count("\n", 0, inline_module.start()) + 1
        errors.append(f"{relative(path)}:{line}: facade contains inline module implementation")
    item = IMPLEMENTATION_ITEM.search(source)
    if item is not None:
        line = source.count("\n", 0, item.start()) + 1
        errors.append(f"{relative(path)}:{line}: facade contains implementation")
    for function in FUNCTION_ITEM.finditer(source):
        if path.name != "main.rs" or function.group(1) != "main":
            line = source.count("\n", 0, function.start()) + 1
            errors.append(f"{relative(path)}:{line}: facade contains function implementation")


def main() -> int:
    files = rust_files()
    errors: list[str] = []
    for path in files:
        name = relative(path)
        source = path.read_text(encoding="utf-8")
        lines = len(source.splitlines())
        if lines > 300:
            errors.append(f"{name}: {lines} lines exceeds 300")
        if not source.startswith("//!"):
            errors.append(f"{name}: missing //! module contract")
        is_test_source = path.name.endswith("_test.rs") or "/tests/" in f"/{name}"
        if not is_test_source:
            if INLINE_TEST.search(source) is not None:
                errors.append(f"{name}: inline cfg(test) module is forbidden")
            if "#[test]" in source:
                errors.append(f"{name}: direct test function is forbidden outside a test file")
        check_facade(path, source, errors)
        check_test_file(path, errors)
        check_module_graph(path, source, errors)
    if errors:
        print("structure violations:", file=sys.stderr)
        for error in errors:
            print(f"- {error}", file=sys.stderr)
        return 1
    print(f"structure: {len(files)} Rust files, facades and tests valid, max 300 lines")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
