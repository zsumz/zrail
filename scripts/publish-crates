#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

: "${ZRAIL_VERSION:?ZRAIL_VERSION is required}"

user_agent="zrail-release/$ZRAIL_VERSION"
packages=(zrail-core zrail-rust zrail)
download_tmp=$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/zrail-registry.XXXXXX")
preflight_tmp=$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/zrail-preflight.XXXXXX")
preflight_source="$preflight_tmp/source"
preflight_source_config=(
    --config "source.crates-io.replace-with = 'zrail-publish-source'"
    --config "source.zrail-publish-source.directory = '$preflight_source'"
)
trap 'rm -rf -- "$download_tmp" "$preflight_tmp"' EXIT

mode=${1:---publish}
if (( $# > 1 )) || [[ "$mode" != --preflight && "$mode" != --publish ]]; then
    echo "usage: scripts/publish-crates [--preflight|--publish]" >&2
    exit 2
fi

require_attested_archives() {
    local package
    for package in "${packages[@]}"; do
        test -f "dist/$package-$ZRAIL_VERSION.crate"
    done
}

remove_generated_archive() {
    local package=$1
    rm -f -- \
        "target/package/$package-$ZRAIL_VERSION.crate" \
        "target/package/tmp-crate/$package-$ZRAIL_VERSION.crate"
}

generated_archive_exists() {
    local package=$1
    [[ -f "target/package/$package-$ZRAIL_VERSION.crate" \
        || -f "target/package/tmp-crate/$package-$ZRAIL_VERSION.crate" ]]
}

require_matching_generated_archive() {
    local package=$1 generated found=false
    for generated in \
        "target/package/$package-$ZRAIL_VERSION.crate" \
        "target/package/tmp-crate/$package-$ZRAIL_VERSION.crate"; do
        if [[ ! -f "$generated" ]]; then
            continue
        fi
        found=true
        if ! cmp "dist/$package-$ZRAIL_VERSION.crate" "$generated"; then
            echo "publish mode generated different bytes for $package" >&2
            return 1
        fi
    done
    if [[ "$found" != true ]]; then
        echo "publish-mode archive was not regenerated for $package" >&2
        return 1
    fi
}

record_preflight_archive() {
    local package=$1 generated proof
    proof="target/publish-preflight/$package-$ZRAIL_VERSION.crate"
    mkdir -p target/publish-preflight
    rm -f -- "$proof"
    for generated in \
        "target/package/$package-$ZRAIL_VERSION.crate" \
        "target/package/tmp-crate/$package-$ZRAIL_VERSION.crate"; do
        if [[ -f "$generated" ]]; then
            cp "$generated" "$proof"
            return
        fi
    done
    echo "publish-mode archive was not available to record for $package" >&2
    return 1
}

compare_preflight_archives() {
    local package proof
    for package in "${packages[@]}"; do
        proof="target/publish-preflight/$package-$ZRAIL_VERSION.crate"
        if [[ ! -f "$proof" ]] \
            || ! cmp "dist/$package-$ZRAIL_VERSION.crate" "$proof"; then
            echo "publish-mode preflight proof differs for $package" >&2
            return 1
        fi
    done
}

preflight_attested_archives() {
    local index package
    local -a dependency_args publish_args stage_args
    cargo vendor --locked --versioned-dirs "$preflight_source" >/dev/null
    for index in "${!packages[@]}"; do
        package=${packages[$index]}
        remove_generated_archive "$package"
        publish_args=(
            publish --package "$package" --locked --no-verify --dry-run
            --registry crates-io "${preflight_source_config[@]}"
        )
        cargo "${publish_args[@]}"
        require_matching_generated_archive "$package"
        dependency_args=()
        case "$package" in
            zrail-rust)
                dependency_args+=(--locked-dependency zrail-core "$ZRAIL_VERSION" \
                    "dist/zrail-core-$ZRAIL_VERSION.crate")
                ;;
            zrail)
                dependency_args+=(
                    --locked-dependency zrail-core "$ZRAIL_VERSION"
                    "dist/zrail-core-$ZRAIL_VERSION.crate"
                    --locked-dependency zrail-rust "$ZRAIL_VERSION"
                    "dist/zrail-rust-$ZRAIL_VERSION.crate"
                )
                ;;
        esac
        stage_args=(python3 scripts/stage-crate-source.py \
            --archive "dist/$package-$ZRAIL_VERSION.crate" \
            --directory "$preflight_source" \
            --name "$package" \
            --version "$ZRAIL_VERSION")
        if (( ${#dependency_args[@]} > 0 )); then
            stage_args+=("${dependency_args[@]}")
        fi
        "${stage_args[@]}"
        record_preflight_archive "$package"
    done
    compare_preflight_archives
}

require_attested_archives
if [[ "$mode" == --preflight ]]; then
    preflight_attested_archives
    preflight_status=$?
    if (( preflight_status != 0 )); then
        exit "$preflight_status"
    fi
    exit 0
fi

: "${CARGO_REGISTRY_TOKEN:?CARGO_REGISTRY_TOKEN is required}"
# A separate pre-publication step must have regenerated every archive with the
# pinned publish toolchain. Refuse all registry traffic if that proof is absent.
compare_preflight_archives

metadata_url() {
    printf 'https://crates.io/api/v1/crates/%s/%s' "$1" "$ZRAIL_VERSION"
}

download_url() {
    printf 'https://crates.io/api/v1/crates/%s/%s/download' "$1" "$ZRAIL_VERSION"
}

registry_status() {
    local package=$1
    curl --user-agent "$user_agent" --silent --show-error \
        --output /dev/null --write-out '%{http_code}' "$(metadata_url "$package")"
}

download_exact_registry_archive() {
    local package=$1
    local expected="dist/$package-$ZRAIL_VERSION.crate"
    local downloaded="$download_tmp/$package-$ZRAIL_VERSION.crate"
    if ! curl --user-agent "$user_agent" --fail --silent --show-error --location \
        --output "$downloaded" "$(download_url "$package")"; then
        return 1
    fi
    if ! cmp "$expected" "$downloaded"; then
        echo "published $package archive differs from the attested archive" >&2
        return 2
    fi
}

published=()
for package in "${packages[@]}"; do
    status=$(registry_status "$package")
    case "$status" in
        404) published+=(no) ;;
        200)
            download_exact_registry_archive "$package"
            published+=(yes)
            ;;
        *)
            echo "crates.io returned HTTP $status while checking $package" >&2
            exit 1
            ;;
    esac
done

for index in "${!packages[@]}"; do
    package=${packages[$index]}
    if [[ "${published[$index]}" == yes ]]; then
        continue
    fi

    verified=false
    publish_status=1
    for attempt in {1..30}; do
        remove_generated_archive "$package"
        set +e
        cargo publish --package "$package" --locked --no-verify --registry crates-io
        publish_status=$?
        set -e

        if generated_archive_exists "$package"; then
            require_matching_generated_archive "$package"
        elif (( publish_status == 0 )); then
            echo "Cargo reported success without regenerating $package" >&2
            exit 1
        fi

        set +e
        download_exact_registry_archive "$package"
        archive_status=$?
        set -e
        case "$archive_status" in
            0)
                verified=true
                break
                ;;
            2) exit 1 ;;
        esac
        if (( attempt < 30 )); then sleep 10; fi
    done
    if [[ "$verified" != true ]]; then
        echo "$package did not become downloadable; cargo publish status: $publish_status" >&2
        exit 1
    fi
done
