#!/usr/bin/env python3
"""Translate frozen qualification text assertions; trusted setup only."""

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import tomllib


ROOT = Path(__file__).resolve().parent.parent
SOURCE_SHA = "92ad5631e90164e10613b02327dfd9714e771a7e350e1ee0058a9170f01c97ad"
READ_SHA = "bb0f3392b649b75ad417923e98559137f28b67e98815cbfa0470bb64808bc843"


def literal(value):
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{key} = {literal(item)}" for key, item in value.items()) + " }"
    return json.dumps(value, ensure_ascii=False)


def policies(rows):
    rules = []
    for row in rows:
        if not row["id"].startswith("KD-QUAL-"):
            continue
        semantics = row["matching_semantics"]
        kind = semantics["kind"]
        path, = row["selection"]["paths"]
        expected_sha = READ_SHA if kind == "Rust fs::read_to_string precondition" else SOURCE_SHA
        if row["source"]["file_sha256"] != expected_sha:
            raise ValueError("qualification assertion source changed")
        if kind == "Rust fs::read_to_string precondition":
            predicate = dict(kind="bytes-equal", other=path, utf8=True)
        elif kind in ["whole UTF-8 literal match", "whole UTF-8 literal presence"]:
            predicate = dict(kind="literal", text=semantics["literal"], mode=semantics["mode"],
                             case=semantics["case"], normalization=semantics["normalization"])
            if semantics["mode"] == "exact-count":
                predicate["count"] = row["required_cardinality"]["exact"]
        elif kind == "raw first-occurrence byte order":
            predicate = dict(kind="literal-order", before=semantics["before"], after=semantics["after"])
        elif kind == "literal within raw first-marker interval":
            predicate = dict(kind="literal-between", start=semantics["start"], end=semantics["end"],
                             contains=semantics["literal"])
        elif kind == "trimmed line prefix value allowlist":
            predicate = dict(kind="line-values-allowed", prefix=semantics["prefix"],
                             values=semantics["allowed"], normalization="trim")
        else:
            raise ValueError(f"unsupported qualification assertion: {row['id']}")
        rules.append(dict(name=row["id"].lower(), include=[path], predicate=predicate,
                          reason="Preserve the frozen raw UTF-8 assertion and its exact matching scope; workflow structure and execution remain separate claims."))
    if len(rules) != 125:
        raise ValueError("incomplete qualification translation")
    return sorted(rules, key=lambda rule: rule["name"])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("snapshots", type=Path)
    parser.add_argument("output", type=Path)
    args = parser.parse_args()
    subprocess.run(["python3", str(ROOT / "scripts/rc9-snapshots"), str(args.snapshots)], check=True)
    for path, digest in [("qualification.rs", SOURCE_SHA), ("support.rs", READ_SHA)]:
        source = args.snapshots / "kafka-driver/tests/guardrails" / path
        if hashlib.sha256(source.read_bytes()).hexdigest() != digest:
            raise ValueError("frozen qualification source changed")
    rows = json.loads((ROOT / "crates/zrail-testkit/tests/fixtures/rc9/assertions.json").read_text())["reviewed_assertions"]
    rules = policies(rows)
    lines = ["# Partial raw-file fragment; full repository qualification remains required.",
             "# Frozen Kafka-driver: a45be8071e6a663cd4ae3142cc5304ece9fdf45e", "# Detector SHA-256: " + SOURCE_SHA,
             "# CI read precondition: repository:file:kd-dep-read-ci in raw-dependency.fragment.toml.",
             "# KD-CI-ENFORCEMENT requires a separately qualified enforced zrail lane."]
    for rule in rules:
        lines += ["", "[[repository.files]]"] + [f"{key} = {literal(value)}" for key, value in rule.items()]
    text = "\n".join(lines) + "\n"
    tomllib.loads(text)
    with args.output.open("x", encoding="utf-8", newline="\n") as output:
        output.write(text)
    print(f"qualification translation: {len(rules)} policies")


if __name__ == "__main__":
    main()
