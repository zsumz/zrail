#!/usr/bin/env python3
"""Run committed native/frozen-oracle suites twice before binding any corrected tree assertion."""

import argparse
import os
from pathlib import Path
import runpy
import sys

sys.dont_write_bytecode = True

from rc9_retired_boundary_common import (
    ROOT, POLICY, PREFIX, QUALIFIER, SUITES, canonical, execution, git, parse, require, run, sha,
)


def checked(arguments, env, log):
    result = run(arguments, env)
    require(not log.exists(), "never replace an execution log")
    log.write_bytes(result.stdout + b"\n--- stderr ---\n" + result.stderr)
    require(result.returncode == 0, "failed command; see " + str(log))
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--snapshots", type=Path, required=True)
    parser.add_argument("--directory", type=Path, required=True)
    parser.add_argument("--report", required=True)
    parser.add_argument("--build", type=Path, required=True)
    args = parser.parse_args()
    directory, snapshots = args.directory.resolve(strict=True), args.snapshots.resolve(strict=True)
    build = args.build.resolve()
    output = directory / args.report
    require(Path(args.report).name == args.report and not output.exists(), "fresh report basename")
    require(directory.is_relative_to("/Volumes/zdev") and build.is_relative_to("/Volumes/zdev"), "zdev storage required")
    require(not directory.is_relative_to(ROOT) and not directory.is_relative_to(snapshots)
            and not build.is_relative_to(snapshots), "independent evidence storage")
    require(not git("status", "--porcelain=v1", "--untracked-files=all"), "clean committed producer required")
    commit, tree = git("rev-parse", "HEAD"), git("rev-parse", "HEAD^{tree}")
    # Reuse the already-reviewed strict local Cargo environment, including the
    # concurrency-only home configuration exception and explicit compiler pin.
    env = runpy.run_path(ROOT / "scripts/rc9-route-runtime")["environment"](build, directory)
    for parent in [ROOT, *ROOT.parents]:
        require(not any((parent / ".cargo" / file).exists() for file in ["config", "config.toml"]),
                "producer ancestor Cargo configuration")
    checked([sys.executable, ROOT / "scripts/rc9-snapshots", snapshots], env,
            directory / (args.report + ".snapshots-before.log"))
    compiler = checked(["rustc", "-Vv"], env, directory / (args.report + ".compiler.log"))
    require("host: aarch64-apple-darwin\n" in compiler.stdout.decode(), "Unix qualification host required")
    command = ["cargo", "test", "-p", "zrail-rust", "--lib", "--all-features", "--locked", "--offline",
               "--no-run", "--message-format=json"]
    print("building committed retired-tree suite", flush=True)
    built = checked(command, env, directory / (args.report + ".build.log"))
    artifacts = [parse(line) for line in built.stdout.splitlines() if line.startswith(b"{")]
    binary, = [item for item in artifacts if item.get("reason") == "compiler-artifact" and item.get("executable")]
    require(any(item.get("reason") == "build-finished" and item.get("success") is True for item in artifacts),
            "missing successful build outcome")
    require(binary["target"]["name"] == "zrail_rust" and binary["target"]["kind"] == ["lib"]
            and binary["profile"]["test"] is True
            and Path(binary["target"]["src_path"]).resolve() == ROOT / "crates/zrail-rust/src/lib.rs", "wrong source target")
    executable = Path(binary["executable"]).resolve(strict=True)
    require(executable.is_relative_to(build), "foreign build executable")
    binary_hash = sha(executable.read_bytes())
    listing = checked([executable, "--list", "--format=terse"], env, directory / (args.report + ".listing.log"))
    names = listing.stdout.decode().splitlines()
    require(names and all(line.endswith(": test") for line in names) and len(set(names)) == len(names), "ambiguous test inventory")
    executions = []
    suites = [(PREFIX + name, *spec) for name, spec in SUITES.items()]
    suites.append((QUALIFIER, True, "ordinary-frozen", 144))
    ordinary_path = directory / (args.report + ".ordinary.json")
    require(not ordinary_path.exists(), "fresh frozen report")
    env.update(ZRAIL_RC9_SNAPSHOTS=str(snapshots), ZRAIL_RC9_RETIRED_BOUNDARY_REPORT=str(ordinary_path))
    for index, (name, ignored, scope, cases) in enumerate(suites):
        require(names.count(name + ": test") == 1, "required suite missing")
        args_for_test = [executable, name, "--exact"] + (["--ignored"] if ignored else [])
        print("executing " + name, flush=True)
        result = checked(args_for_test, env, directory / f"{args.report}.suite-{index:02}.log")
        executions.append({"test": name, "ignored_switch": ignored, "scope": scope, "cases": cases,
                           "outcome": execution(result.stdout, result.returncode, name, len(names))})
    ordinary_bytes = ordinary_path.read_bytes()
    ordinary = parse(ordinary_bytes)
    require(ordinary["implementation_commit"] == commit and ordinary["implementation_tree"] == tree
            and ordinary["test_binary_sha256"] == binary_hash, "unbound frozen qualifier")
    inputs = ["scripts/rc9-retired-boundaries", "scripts/rc9_retired_boundary_common.py", "scripts/rc9-route-runtime",
              "scripts/rc9_route_runtime_common.py", "crates/zrail-rust/src/inventory/io.rs",
              "crates/zrail-rust/src/inventory/traverse.rs", "crates/zrail-rust/src/repository_files.rs",
              "crates/zrail-rust/src/repository_files/select.rs"]
    inputs += [path for path in git("ls-files", "crates/zrail-rust/tests/rc9_declarations").splitlines() if path.endswith(".rs")]
    report = {"schema": 1, "implementation_commit": commit, "implementation_tree": tree,
              "snapshot": ordinary["snapshot"], "full_repository_qualified": False,
              "policy_path": POLICY, "policy_sha256": sha((ROOT / POLICY).read_bytes()),
              "rustc_version": compiler.stdout.decode().strip(), "cargo_lock_sha256": sha((ROOT / "Cargo.lock").read_bytes()),
              "binary_path": str(executable), "test_binary_sha256": binary_hash,
              "listing_sha256": sha(listing.stdout), "total_tests": len(names), "build_command": command,
              "producer_inputs": {path: sha((ROOT / path).read_bytes()) for path in sorted(inputs)},
              "executions": executions, "ordinary_sha256": sha(ordinary_bytes), "ordinary": ordinary,
              "limitations": ["Unix physical qualification; no downstream cutover or full-policy proof.",
                              "Seven cycles execute native analysis only, never the unbounded old walker.",
                              "Injected iterator-expression and native scanner failures are not observed OS entry errors."]}
    checked([sys.executable, ROOT / "scripts/rc9-snapshots", snapshots], env,
            directory / (args.report + ".snapshots-after.log"))
    require(not git("status", "--porcelain=v1", "--untracked-files=all") and git("rev-parse", "HEAD") == commit
            and sha(executable.read_bytes()) == binary_hash, "producer changed during execution")
    with output.open("xb") as stream:
        stream.write(canonical(report))
    print("retired boundary report: " + sha(output.read_bytes()), flush=True)


if __name__ == "__main__":
    main()
