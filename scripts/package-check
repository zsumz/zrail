#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

version=$(awk -F'"' '/^version = "/ { print $2; exit }' Cargo.toml)
package_target=${CARGO_TARGET_DIR:-"$repo_root/target"}
if [[ "$package_target" != /* ]]; then
    package_target="$repo_root/$package_target"
fi
export CARGO_TARGET_DIR="$package_target"
package_tmp=$(mktemp -d "${TMPDIR:-/tmp}/zrail-package-check.XXXXXX")
trap 'rm -rf -- "$package_tmp"' EXIT

packages=(zrail-core zrail-rust zrail)
source_core_patch="patch.crates-io.zrail-core.path = '$repo_root/crates/zrail-core'"
source_rust_patch="patch.crates-io.zrail-rust.path = '$repo_root/crates/zrail-rust'"
for package in "${packages[@]}"; do
    package_args=(--package "$package" --allow-dirty --locked --offline)
    if [[ "$package" == "zrail-core" ]]; then
        cargo package "${package_args[@]}"
    elif [[ "$package" == "zrail-rust" ]]; then
        cargo package "${package_args[@]}" --no-verify --config "$source_core_patch"
    else
        cargo package "${package_args[@]}" --no-verify \
            --config "$source_core_patch" --config "$source_rust_patch"
    fi
    archive="$package_target/package/$package-$version.crate"
    for required in LICENSE README.md; do
        if ! tar -tzf "$archive" | grep -Fx "$package-$version/$required" >/dev/null; then
            echo "$package archive is missing $required" >&2
            exit 1
        fi
    done
    tar -xzf "$archive" -C "$package_tmp"
    for required in LICENSE README.md; do
        cmp "$required" "$package_tmp/$package-$version/$required"
    done
done

core="$package_tmp/zrail-core-$version"
rust="$package_tmp/zrail-rust-$version"
cli="$package_tmp/zrail-$version"
core_patch="patch.crates-io.zrail-core.path = '$core'"
rust_patch="patch.crates-io.zrail-rust.path = '$rust'"
archive_target="$package_tmp/target"
for package_dir in "$rust" "$cli"; do
    cp Cargo.lock "$package_dir/Cargo.lock"
done

cargo check --manifest-path "$core/Cargo.toml" --locked --offline --target-dir "$archive_target"
cargo check --manifest-path "$rust/Cargo.toml" --locked --offline \
    --target-dir "$archive_target" --config "$core_patch"
cargo check --manifest-path "$cli/Cargo.toml" --locked --offline \
    --target-dir "$archive_target" \
    --config "$core_patch" --config "$rust_patch"
