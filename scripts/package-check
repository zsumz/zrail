#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

version=$(awk -F'"' '/^version = "/ { print $2; exit }' Cargo.toml)
package_target=${CARGO_TARGET_DIR:-"$repo_root/target"}
if [[ "$package_target" != /* ]]; then
    package_target="$repo_root/$package_target"
fi
export CARGO_TARGET_DIR="$package_target"
package_tmp=$(mktemp -d "${TMPDIR:-/tmp}/zrail-package-check.XXXXXX")
trap 'rm -rf -- "$package_tmp"' EXIT

packages=(zrail-core zrail-rust zrail)
source_dir="$package_tmp/source"
expanded_target="$package_tmp/target"
source_config=(
    --config "source.crates-io.replace-with = 'zrail-package-source'"
    --config "source.zrail-package-source.directory = '$source_dir'"
)
cargo vendor --locked --offline --versioned-dirs "$source_dir" >/dev/null

for package in "${packages[@]}"; do
    rm -f -- \
        "$package_target/package/$package-$version.crate" \
        "$package_target/package/tmp-crate/$package-$version.crate"
    cargo package --package "$package" --allow-dirty --locked --offline \
        --no-verify --registry crates-io "${source_config[@]}"
    archive="$package_target/package/$package-$version.crate"
    dependency_args=()
    case "$package" in
        zrail-rust)
            dependency_args+=(--locked-dependency zrail-core "$version" \
                "$package_target/package/zrail-core-$version.crate")
            ;;
        zrail)
            dependency_args+=(
                --locked-dependency zrail-core "$version"
                "$package_target/package/zrail-core-$version.crate"
                --locked-dependency zrail-rust "$version"
                "$package_target/package/zrail-rust-$version.crate"
            )
            ;;
    esac
    stage_args=(python3 scripts/stage-crate-source.py \
        --archive "$archive" \
        --directory "$source_dir" \
        --name "$package" \
        --version "$version")
    if (( ${#dependency_args[@]} > 0 )); then
        stage_args+=("${dependency_args[@]}")
    fi
    "${stage_args[@]}"
    for required in LICENSE README.md; do
        cmp "$required" "$source_dir/$package-$version/$required"
    done
done

for package in "${packages[@]}"; do
    package_dir="$source_dir/$package-$version"
    cargo check --manifest-path "$package_dir/Cargo.toml" --locked --offline \
        --target-dir "$expanded_target" "${source_config[@]}"
done
